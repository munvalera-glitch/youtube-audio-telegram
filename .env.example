# Токен Telegram-бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Список разрешенных Telegram ID пользователей через запятую (например: 123456789,987654321)
# Чтобы узнать свой ID, запустите бота и отправьте команду /whoami
ALLOWED_USER_IDS=

# Папка для сохранения скачанных аудиодорожек
DOWNLOAD_DIR=./downloads

# (Опционально) Путь к файлу cookies.txt для работы при строгой защите YouTube
# Если в папке бота лежит файл cookies.txt, он подхватится автоматически
COOKIES_FILE=
